{
  "identifier": "com.parkcedar.java",
  "name": "Java",
  "organization": "Parkcedar",
  "description": "Complete Java development support with Eclipse JDT.LS, tree-sitter syntax highlighting, intelligent code completion, navigation, refactoring, and real-time diagnostics.",
  "version": "1.2.0",
  "categories": [
    "commands",
    "languages",
    "formatters",
    "completions",
    "issues",
    "sidebars"
  ],
  "license": "MIT",
  "min_runtime": "10.0",
  "bugs": "https://github.com/lachierussell/nova-java/issues",
  "repository": "https://github.com/lachierussell/nova-java",
  "main": "main.dist.js",
  "entitlements": {
    "process": true,
    "filesystem": "readwrite",
    "requests": true
  },

  "commands": {
    "editor": [
      {
        "title": "Jump To Definition",
        "command": "java.jumpToDefinition",
        "filters": {
          "syntaxes": ["java"]
        }
      },
      {
        "title": "Jump To Type Definition",
        "command": "java.jumpToTypeDefinition",
        "filters": {
          "syntaxes": ["java"]
        }
      },
      {
        "title": "Jump To Implementation",
        "command": "java.jumpToImplementation",
        "filters": {
          "syntaxes": ["java"]
        }
      },
      { "separator": true },
      {
        "title": "Find References",
        "command": "java.findReferences",
        "filters": {
          "syntaxes": ["java"]
        }
      },
      {
        "title": "Find Symbol",
        "command": "java.findSymbols",
        "filters": {
          "syntaxes": ["java"]
        }
      },
      { "separator": true },
      {
        "title": "Code Actions…",
        "command": "java.codeActions",
        "shortcut": "opt-enter",
        "filters": {
          "syntaxes": ["java"]
        }
      },
      {
        "title": "Rename Symbol",
        "command": "java.renameSymbol",
        "filters": {
          "syntaxes": ["java"]
        }
      },
      { "separator": true },
      {
        "title": "Format File",
        "command": "java.formatFile",
        "shortcut": "opt-shift-f",
        "filters": {
          "syntaxes": ["java"]
        }
      },
      {
        "title": "Format Selection",
        "command": "java.formatSelection",
        "filters": {
          "syntaxes": ["java"]
        }
      },
      {
        "title": "Organize Imports",
        "command": "java.organizeImports",
        "filters": {
          "syntaxes": ["java"]
        }
      },
      { "separator": true },
      {
        "title": "Preferences",
        "command": "java.preferences",
        "filters": {
          "syntaxes": ["java"]
        }
      },
      {
        "title": "Extension Preferences",
        "command": "java.extensionPreferences",
        "filters": {
          "syntaxes": ["java"]
        }
      }
    ],
    "extensions": [
      {
        "title": "Extension Preferences",
        "command": "java.extensionPreferences"
      },
      {
        "title": "Restart Language Server",
        "command": "java.restartServer",
        "filters": { "syntaxes": ["java"] }
      }
    ]
  },

  "config": [
    {
      "title": "Language Server",
      "type": "section",
      "children": [
        {
          "key": "java.lsp.flavor",
          "title": "Language server to use",
          "description": "Which language server to use",
          "type": "enum",
          "values": [
            ["auto", "Automatic (Eclipse JDT.LS)"],
            ["custom", "Custom server"],
            ["none", "None"]
          ],
          "radio": false,
          "default": "auto"
        },
        {
          "key": "java.lsp.path",
          "title": "Language server Path",
          "description": "Path to a custom language server executable or JAR",
          "type": "path",
          "placeholder": "/usr/local/bin/jdtls"
        },
        {
          "key": "java.jdk.home",
          "title": "Java JDK Home",
          "type": "path",
          "description": "Path to the JDK installation (will search JAVA_HOME and common locations if blank)",
          "placeholder": "/Library/Java/JavaVirtualMachines/jdk-17.jdk/Contents/Home"
        }
      ]
    },
    {
      "title": "Project",
      "type": "section",
      "children": [
        {
          "key": "java.project.root",
          "title": "Project Root",
          "description": "Directory the language server treats as the project root. Absolute, or relative to the workspace. Leave blank to use the workspace folder.",
          "type": "path",
          "allowFiles": false,
          "allowFolders": true,
          "placeholder": "Workspace folder"
        },
        {
          "key": "java.gradle.wrapperPath",
          "title": "Gradle Wrapper Path",
          "description": "Path to gradlew (or the folder containing it). Leave blank to search upwards from the project root.",
          "type": "path",
          "placeholder": "Search upwards from the project root"
        }
      ]
    },
    {
      "title": "Formatting",
      "type": "section",
      "children": [
        {
          "key": "java.format.onSave",
          "title": "Format on save",
          "description": "Format Java files automatically when saving.",
          "type": "boolean",
          "default": false
        },
        {
          "key": "java.format.organizeImportsOnSave",
          "title": "Organize imports on save",
          "description": "Remove unused imports and reorder them when saving.",
          "type": "boolean",
          "default": false
        },
        {
          "key": "java.format.formatter",
          "title": "Formatter",
          "description": "Choose which formatter to use",
          "type": "enum",
          "values": [
            ["lsp", "Language Server (Eclipse JDT)"],
            ["spotless", "Gradle Spotless (Palantir)"]
          ],
          "default": "lsp"
        },
        {
          "key": "java.format.style",
          "title": "Formatting style",
          "description": "Code formatting style preset (for LSP formatter only). “Palantir” is only available with the Spotless formatter.",
          "type": "enum",
          "values": [
            ["google", "Google Java Style"],
            ["aosp", "Android Open Source Project"],
            ["eclipse", "Eclipse"],
            ["custom", "Custom"]
          ],
          "default": "google"
        },
        {
          "key": "java.format.settings.url",
          "title": "Custom formatter profile",
          "description": "Eclipse formatter XML to use when “Formatting style” is Custom. A file path or a URL.",
          "type": "path",
          "placeholder": "~/eclipse-formatter.xml"
        },
        {
          "key": "java.format.spotlessOffline",
          "title": "Run Spotless offline",
          "description": "Pass --offline to Gradle. Without a network, Spotless otherwise stalls for minutes before failing.",
          "type": "boolean",
          "default": false
        }
      ]
    },
    {
      "title": "Inlay Hints",
      "type": "section",
      "children": [
        {
          "key": "java.inlayHints.parameterNames",
          "title": "Parameter name hints",
          "description": "Show inline parameter names at call sites.",
          "type": "enum",
          "values": [
            ["none", "None"],
            ["literals", "Literals only"],
            ["all", "All"]
          ],
          "default": "none"
        }
      ]
    },
    {
      "title": "Linting",
      "type": "section",
      "children": [
        {
          "key": "java.lint.enabled",
          "title": "Enable linting",
          "description": "Enable diagnostic linting via language server",
          "type": "boolean",
          "default": true
        }
      ]
    },
    {
      "title": "Debugging",
      "type": "section",
      "children": [
        {
          "key": "java.debug.logServerTrace",
          "title": "Log language server traffic",
          "description": "Write the LSP conversation to the Extension Console. Slow and noisy — turn it on only to diagnose a server that is not answering.",
          "type": "boolean",
          "default": false
        }
      ]
    }
  ],

  "configWorkspace": [
    {
      "key": "java.jdk.home",
      "title": "Java JDK Home",
      "type": "path",
      "description": "Path to the JDK installation (will search JAVA_HOME and common locations if blank)",
      "placeholder": "Global Default"
    },
    {
      "key": "java.debug.logServerTrace",
      "title": "Log language server traffic",
      "description": "Write the LSP conversation to this project's server data directory. Slow and noisy — turn it on only to diagnose a server that is not answering.",
      "type": "enum",
      "values": [
        [null, "Inherit from Global Settings"],
        [false, "Disable"],
        [true, "Enable"]
      ],
      "default": null
    },
    {
      "key": "java.format.onSave",
      "title": "Format on save",
      "description": "Format Java files automatically when saving.",
      "type": "enum",
      "values": [
        [null, "Inherit from Global Settings"],
        [false, "Disable"],
        [true, "Enable"]
      ],
      "default": null
    },
    {
      "key": "java.format.organizeImportsOnSave",
      "title": "Organize imports on save",
      "description": "Remove unused imports and reorder them when saving.",
      "type": "enum",
      "values": [
        [null, "Inherit from Global Settings"],
        [false, "Disable"],
        [true, "Enable"]
      ],
      "default": null
    },
    {
      "key": "java.format.formatter",
      "title": "Formatter",
      "description": "Choose which formatter to use",
      "type": "enum",
      "values": [
        [null, "Inherit from Global Settings"],
        ["lsp", "Language Server (Eclipse JDT)"],
        ["spotless", "Gradle Spotless (Palantir)"]
      ],
      "default": null
    },
    {
      "key": "java.project.root",
      "title": "Project Root",
      "description": "Directory the language server treats as the project root. Absolute, or relative to the workspace. Leave blank to use the workspace folder.",
      "type": "path",
      "allowFiles": false,
      "allowFolders": true,
      "placeholder": "Workspace folder"
    },
    {
      "key": "java.gradle.wrapperPath",
      "title": "Gradle Wrapper Path",
      "description": "Path to gradlew (or the folder containing it). Leave blank to search upwards from the project root.",
      "type": "path",
      "placeholder": "Search upwards from the project root"
    },
    {
      "key": "java.project.sourcePaths",
      "title": "Source Paths",
      "description": "Additional source paths for the project",
      "type": "stringArray"
    },
    {
      "key": "java.project.outputPath",
      "title": "Output Path",
      "description": "Compiled class output directory",
      "type": "string",
      "placeholder": "bin"
    },
    {
      "key": "java.project.referencedLibraries",
      "title": "Referenced Libraries",
      "description": "JAR files or directories to include in classpath",
      "type": "stringArray"
    }
  ],

  "sidebars": [
    {
      "id": "java.sidebar",
      "name": "Java",
      "smallImage": "java-sidebar-small",
      "largeImage": "java-sidebar-large",
      "sections": [
        {
          "id": "java.sidebar.info",
          "name": "Language Server",
          "placeholderText": "Java language server status.",
          "headerCommands": [
            {
              "title": "Restart Language Server",
              "command": "java.restartServer",
              "image": "__builtin.refresh",
              "tooltip": "Restart the Java language server"
            }
          ]
        },
        {
          "id": "java.sidebar.references",
          "name": "References",
          "placeholderText": "Results from \"Find References\" appear here."
        },
        {
          "id": "java.sidebar.symbols",
          "name": "Symbols",
          "placeholderText": "No symbols in the active Java file."
        }
      ]
    }
  ],

  "activationEvents": [
    "onLanguage:java"
  ]
}
